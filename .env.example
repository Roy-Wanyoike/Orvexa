# Orvexa environment (copy to .env — never commit .env)
# All settings have safe local defaults; the platform boots with zero external dependencies.

# HTTP API
ORVEXA_HTTP_ADDR=":8080"
# Realtime websocket gateway
ORVEXA_REALTIME_ADDR=":8081"

# PostgreSQL (optional for the in-process profile; required for durable operation)
# Integration tests skip unless ORVEXA_TEST_DATABASE_URL is set.
ORVEXA_DATABASE_URL="postgres://orvexa:orvexa@localhost:5432/orvexa?sslmode=disable"
ORVEXA_DB_MAX_CONNS="20"

# Event bus driver: inproc | nats
ORVEXA_BUS_DRIVER="inproc"
ORVEXA_NATS_URL="nats://localhost:4222"

# Logging: debug | info | warn | error
ORVEXA_LOG_LEVEL="info"

# Auth: bootstrap admin API key (hashed at rest; shown once at first boot when set)
ORVEXA_BOOTSTRAP_API_KEY=""

# AI gateway (provider-agnostic; no keys are ever committed)
ORVEXA_AI_PROVIDER="rules"
ORVEXA_AI_LLM_BASE_URL=""
ORVEXA_AI_LLM_API_KEY=""
ORVEXA_AI_MAX_TOKENS="1024"
ORVEXA_AI_TIMEOUT_SECONDS="30"

# Communication provider profile: simulator | twilio | whatsapp_cloud | africastalking
ORVEXA_COMMS_PROVIDER="simulator"
# HMAC secret used by provider webhook signature validation (simulator signs with this)
ORVEXA_WEBHOOK_HMAC_SECRET=""
